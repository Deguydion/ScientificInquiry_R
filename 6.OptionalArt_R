# 2 - ambient + ggplot2 : texture / noise art

install.packages(c("ambient", "ggplot2", "dplyr"))
library(ambient)
library(ggplot2)
library(dplyr)

# Create a grid of x/y positions
noise_df <- expand.grid(
  x = 1:400,
  y = 1:200
)

# Generate Perlin noise
noise_df$z <- gen_perlin(
  x = noise_df$x,
  y = noise_df$y,
  frequency = 0.03
)

# Turn it into an image
ggplot(noise_df, aes(x, y, fill = z)) +
  geom_raster() +
  coord_equal() +
  theme_void() 

# Stretch the coordinates to create diagonal stripe-like patterns
noise_df2 <- expand.grid(
  x = 1:500,
  y = 1:250
)

noise_df2$z <- gen_perlin(
  x = noise_df2$x * 0.08 + noise_df2$y * 0.25,
  y = noise_df2$y * 0.03,
  frequency = 0.05
)

ggplot(noise_df2, aes(x, y, fill = z)) +
  geom_raster() +
  coord_equal() +
  theme_void()

ggplot(noise_df2, aes(x, y, fill = z)) +
  geom_raster() +
  coord_equal() +
  theme_void() +
  scale_fill_gradientn(colors = c("yellow", "pink", "cyan", "purple", "orange"))

# 3 - qqworldcloud: fun text art

install.packages(c("ggwordcloud", "ggplot2"))
library(ggwordcloud)
library(ggplot2)

words <- data.frame(
  word = c("Manja", "DNA", "RStudio", "evolution", "R", "statistics",
           "genes", "ecology", "data", "plants", "cats", "science"),
  n = c(20, 16, 14, 13, 12, 11, 10, 9, 8, 8, 7, 7)
)

ggplot(words, aes(label = word, size = n, color = n)) +
  geom_text_wordcloud() +
  scale_size_area(max_size = 18) +
  theme_minimal()

#Make it a cloud
ggplot(words, aes(label = word, size = n, color = n)) +
  geom_text_wordcloud_area() +
  scale_size_area(max_size = 18) +
  theme_minimal()

#Change orientation of words
ggplot(words, aes(label = word, size = n, angle = 90)) +
  geom_text_wordcloud() +
  scale_size_area(max_size = 15)

#Change orientation of words: all vertical
ggplot(words, aes(label = word, size = n, angle = 90)) +
  geom_text_wordcloud() +
  scale_size_area(max_size = 15)

# control orientation per word: 
words$angle <- c(0, 90, 0, 90, 45, 0, 90, 0, 0, 90, 0, 45, 90, 0, 0)
ggplot(words, aes(label = word, size = n, angle = angle)) +
  geom_text_wordcloud() +
  scale_size_area(max_size = 15)

# Random orientation clean script: 
set.seed(1)
words$angle <- sample(c(0, 90), nrow(words), replace = TRUE)

ggplot(words, aes(label = word, size = n, angle = angle)) +
  geom_text_wordcloud() +
  scale_size_area(max_size = 15)

# 4 - magick: image manipulation

install.packages("magick")
library(magick)

# Create a blank image
img <- image_blank(width = 500, height = 300, color = "white")

# Add text
img_text <- image_annotate(
  img,
  "R is fun",
  size = 60,
  color = "black",
  gravity = "center"
)

img_text

#Blur, rotate and stylize
image_blur(img_text, radius = 5)
image_rotate(img_text, 15)
image_negate(img_text)

#Combine two images side by side
img1 <- image_blank(300, 300, color = "orange")
img2 <- image_blank(300, 300, color = "skyblue")

combined <- image_append(c(img1, img2))
combined


