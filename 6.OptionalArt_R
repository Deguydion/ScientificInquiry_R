# BONUS - Generative texture art with ambient


# Install once if needed
install.packages(c("ambient", "ggplot2", "dplyr", "patchwork"))

# Load packages
library(ambient)
library(ggplot2)
library(dplyr)
library(patchwork)


# 1 - Basic noise image


# Make a grid of x and y positions
art1 <- expand.grid(
  x = 1:400,
  y = 1:250
)

# Generate Perlin noise
art1$z <- gen_perlin(
  x = art1$x,
  y = art1$y,
  frequency = 0.03
)

# Plot
p1 <- ggplot(art1, aes(x, y, fill = z)) +
  geom_raster() +
  coord_equal() +
  theme_void()

p1


# 2 - Same image with bright colors


p2 <- ggplot(art1, aes(x, y, fill = z)) +
  geom_raster() +
  coord_equal() +
  theme_void() +
  scale_fill_gradientn(colors = c("yellow", "pink", "cyan", "purple", "orange", "white"))

p2


# 3 - Make diagonal streaks


art2 <- expand.grid(
  x = 1:500,
  y = 1:250
)

# Transform coordinates before generating noise
# This creates a more stretched / diagonal look
art2$z <- gen_perlin(
  x = art2$x * 0.10 + art2$y * 0.30,
  y = art2$y * 0.04,
  frequency = 0.05
)

p3 <- ggplot(art2, aes(x, y, fill = z)) +
  geom_raster() +
  coord_equal() +
  theme_void() +
  scale_fill_gradientn(colors = c("yellow", "pink", "cyan", "purple", "orange"))

p3


# 4 - Black / white / orange striped version


p4 <- ggplot(art2, aes(x, y, fill = z)) +
  geom_raster() +
  coord_equal() +
  theme_void() +
  scale_fill_gradientn(colors = c("black", "white", "orange"))

p4

# 5 - Stronger contrast version

# Convert continuous noise to categories
art2$z_cut <- cut(
  art2$z,
  breaks = 6,
  labels = c("A", "B", "C", "D", "E", "F")
)

p5 <- ggplot(art2, aes(x, y, fill = z_cut)) +
  geom_raster() +
  coord_equal() +
  theme_void() +
  scale_fill_manual(values = c("black", "white", "orange", "gold", "grey70", "grey20"))

p5


# 6 - A softer cloud-like version with simplex noise

art3 <- expand.grid(
  x = 1:400,
  y = 1:250
)

art3$z <- gen_simplex(
  x = art3$x * 0.02,
  y = art3$y * 0.02,
  frequency = 0.08
)

p6 <- ggplot(art3, aes(x, y, fill = z)) +
  geom_raster() +
  coord_equal() +
  theme_void() +
  scale_fill_gradientn(colors = c("navy", "skyblue", "white", "pink"))

p6

# 7 - Put several panels together

(p2 | p4 | p3)


# 8 - Save one image


ggsave("ambient_art.png", plot = p3, width = 10, height = 5, dpi = 300) 


# BONUS - Simple animation in magick


# Install once if needed
install.packages("magick")

# Load package
library(magick)


# 1 - Blinking text


# Frame 1: visible text
f1 <- image_blank(width = 500, height = 250, color = "white") |>
  image_annotate("Lady Manja the Swift", size = 50, color = "pink", gravity = "center")

# Frame 2: no text
f2 <- image_blank(width = 500, height = 250, color = "white")

# Repeat frames to make a blinking GIF
blink_frames <- c(f1, f2, f1, f2, f1, f2)

blink_gif <- image_animate(blink_frames, fps = 2)
blink_gif

# Save
image_write(blink_gif, path = "blink.gif")


# 2 - Moving object across the screen


frames_move <- image_join(lapply(seq(20, 420, by = 40), function(pos) {
  image_blank(width = 500, height = 250, color = "white") |>
    image_annotate("●", size = 80, color = "blue", location = paste0("+", pos, "+100"))
}))

move_gif <- image_animate(frames_move, fps = 4)
move_gif

image_write(move_gif, path = "moving_dot.gif")


# 3 - Moving text


frames_text <- image_join(lapply(seq(10, 350, by = 30), function(pos) {
  image_blank(width = 500, height = 250, color = "black") |>
    image_annotate("(=^ω^=)", size = 90, color = "yellow", location = paste0("+", pos, "+90"))
}))

text_gif <- image_animate(frames_text, fps = 5)
text_gif

image_write(text_gif, path = "moving_text.gif")


# 4 - Morph between two images


img_a <- image_blank(500, 250, color = "white") |>
  image_annotate("(=^ω^=)", size = 140, color = "red", gravity = "center")

img_b <- image_blank(500, 250, color = "white") |>
  image_annotate("<^..^>", size = 140, color = "blue", gravity = "center")

morph_frames <- c(img_a, img_b) |>
  image_morph(frames = 12) |>
  image_animate(fps = 5)

morph_frames

image_write(morph_frames, path = "morph_AB.gif")


# 5 - Rotate an object over time


base_img <- image_blank(400, 400, color = "white") |>
  image_annotate("<^..^>", size = 180, color = "darkgreen", gravity = "center")

rot_frames <- image_join(lapply(seq(0, 330, by = 30), function(a) {
  image_rotate(base_img, a)
}))

rot_gif <- image_animate(rot_frames, fps = 5)
rot_gif

image_write(rot_gif, path = "rotate_R.gif")
