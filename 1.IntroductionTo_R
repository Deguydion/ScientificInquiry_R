# 4 - Create a small data frame manually


students <- data.frame(
  name = c("A", "B", "C", "D", "E"),
  height = c(160, 165, 170, 152, 166),
  weight = c(52, 60, 68, 50, 63)
)
students


# 5 - Access columns

students$height
students$weight


# 6 - Simple graphs

hist(students$height)
plot(students$height, students$weight)



# 7 - Packages

# A package is a collection of functions written by other programmers.
# Packages extend the capabilities of R.

# Install a package (only once)
install.packages("ggplot2")

# Load (activate) the package every session
library(ggplot2)

#Use ggplot2 to build the student graph
#General use: plotname <- ggplot(data, variables) + type of graph 

studentplot <- ggplot(data = students, aes(x = height, y = weight)) + geom_point()
studentplot

